From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Fingerprint Lab <noreply@example.invalid>
Date: Tue, 11 Aug 2026 12:57:36 +0200
Subject: [PATCH] libfprint: integrate fail-closed Goodix 550c driver

---
 data/autosuspend.hwdb             |  6 ++++-
 libfprint/fprint-list-udev-hwdb.c |  1 -
 libfprint/meson.build             | 45 ++++++++++++++++++++++++++++---
 meson.build                       |  3 +++
 meson_options.txt                 |  4 +++
 5 files changed, 54 insertions(+), 5 deletions(-)

diff --git a/data/autosuspend.hwdb b/data/autosuspend.hwdb
index 6c15fb9..38333e2 100644
--- a/data/autosuspend.hwdb
+++ b/data/autosuspend.hwdb
@@ -201,6 +201,11 @@ usb:v10A5pC844*
  ID_AUTOSUSPEND=1
  ID_PERSIST=0

+# Supported by fail-closed experimental libfprint driver goodix53x5
+usb:v27C6p550C*
+ ID_AUTOSUSPEND=1
+ ID_PERSIST=0
+
 # Supported by libfprint driver goodixmoc
 usb:v27C6p5840*
 usb:v27C6p6014*
@@ -462,7 +467,6 @@ usb:v27C6p538D*
 usb:v27C6p5395*
 usb:v27C6p5503*
 usb:v27C6p550A*
-usb:v27C6p550C*
 usb:v27C6p5584*
 usb:v27C6p55A2*
 usb:v27C6p55A4*
diff --git a/libfprint/fprint-list-udev-hwdb.c b/libfprint/fprint-list-udev-hwdb.c
index 0527db1..8a8c25a 100644
--- a/libfprint/fprint-list-udev-hwdb.c
+++ b/libfprint/fprint-list-udev-hwdb.c
@@ -142,7 +142,6 @@ static const FpIdEntry allowlist_id_table[] = {
   { .vid = 0x27c6, .pid = 0x5395 },
   { .vid = 0x27c6, .pid = 0x5503 },
   { .vid = 0x27c6, .pid = 0x550a },
-  { .vid = 0x27c6, .pid = 0x550c },
   { .vid = 0x27c6, .pid = 0x5584 },
   { .vid = 0x27c6, .pid = 0x55a2 },
   { .vid = 0x27c6, .pid = 0x55a4 },
diff --git a/libfprint/meson.build b/libfprint/meson.build
index 3449481..9eb5464 100644
--- a/libfprint/meson.build
+++ b/libfprint/meson.build
@@ -147,6 +147,8 @@ driver_sources = {
         [ 'drivers/synaptics/synaptics.c', 'drivers/synaptics/bmkt_message.c' ],
     'goodixmoc' :
         [ 'drivers/goodixmoc/goodix.c', 'drivers/goodixmoc/goodix_proto.c' ],
+    'goodix53x5' :
+        [ 'drivers/goodix53x5/goodix53x5.c', 'drivers/goodix53x5/goodix53x5-proto.c', 'drivers/goodix53x5/goodix53x5-crypto.c', 'drivers/goodix53x5/goodix53x5-tls.c', 'drivers/goodix53x5/goodix53x5-transport.c', 'drivers/goodix53x5/goodix53x5-commands.c', 'drivers/goodix53x5/goodix53x5-session.c', 'drivers/goodix53x5/goodix53x5-scan.c', 'drivers/goodix53x5/goodix53x5-enroll.c', 'drivers/goodix53x5/goodix53x5-auth.c', 'drivers/goodix53x5/goodix53x5-match.c', 'drivers/goodix53x5/goodix53x5-calibration.c', 'drivers/goodix53x5/goodix53x5-image.c' ],
     'fpcmoc' :
         [ 'drivers/fpcmoc/fpc.c' ],
     'realtek' :
@@ -172,6 +174,9 @@ helper_sources = {

 drivers_sources = []
 drivers_cflags = []
+if get_option('goodix550c_volatile_init')
+    drivers_cflags += [ '-DGOODIX550C_ENABLE_VOLATILE_INIT=1' ]
+endif
 foreach driver: drivers
     drivers_sources += driver_sources[driver]
 endforeach
@@ -258,6 +263,40 @@ libnbis = static_library('nbis',
     ]),
     install: false)

+# SIGFM: SIFT-based host matching for the small 550c image sensor.
+opencv_pc = dependency('opencv5', required: false)
+if not opencv_pc.found()
+    opencv_pc = dependency('opencv4', required: false)
+endif
+if opencv_pc.found()
+    opencv_includes = opencv_pc.partial_dependency(compile_args: true, includes: true)
+else
+    # Debian/Ubuntu split the needed headers across component -dev packages;
+    # those packages need not provide the opencv4.pc meta-file.
+    opencv_header_root = '/usr/include/opencv4'
+    if not cpp.has_header('opencv2/core.hpp', args: [ '-I' + opencv_header_root ])
+        error('OpenCV headers not found (install the core, features2d, flann, and imgproc development components)')
+    endif
+    opencv_includes = declare_dependency(
+        compile_args: [ '-isystem', opencv_header_root ],
+    )
+endif
+opencv_core = cc.find_library('opencv_core')
+opencv_features2d = cc.find_library('opencv_features2d', required: false)
+if not opencv_features2d.found()
+    opencv_features2d = cc.find_library('opencv_features')
+endif
+opencv_flann = cc.find_library('opencv_flann')
+opencv_imgproc = cc.find_library('opencv_imgproc')
+opencv_dep = declare_dependency(
+    dependencies: [opencv_includes, opencv_core, opencv_features2d, opencv_flann, opencv_imgproc],
+)
+libsigfm = static_library('sigfm',
+    'sigfm/sigfm.cpp',
+    dependencies: [opencv_dep],
+    cpp_args: [ '-std=c++17' ],
+    install: false)
+
 libfprint_private = static_library('fprint-private',
     sources: [
         fpi_enums,
@@ -271,7 +310,7 @@ libfprint_drivers = static_library('fprint-drivers',
     sources: drivers_sources,
     c_args: drivers_cflags,
     dependencies: deps,
-    link_with: libfprint_private,
+    link_with: [libfprint_private, libsigfm],
     install: false)

 mapfile = files('libfprint.ver')[0]
@@ -291,8 +330,8 @@ libfprint = shared_library(versioned_libname.split('lib')[1],
     version: libversion,
     link_args : vflag,
     link_depends : mapfile,
-    link_with: [libfprint_drivers, libfprint_private],
-    dependencies: deps,
+    link_with: [libfprint_drivers, libfprint_private, libsigfm],
+    dependencies: deps + [opencv_dep],
     install: true)

 libfprint_dep = declare_dependency(link_with: libfprint,
diff --git a/meson.build b/meson.build
index 14fb11f..bb03892 100644
--- a/meson.build
+++ b/meson.build
@@ -140,6 +140,7 @@ default_drivers = [
     'upeksonly',
     'upekts',
     'goodixmoc',
+    'goodix53x5',
     'nb1010',
     'fpcmoc',
     'realtek',
@@ -168,6 +169,7 @@ endian_independent_drivers = virtual_drivers + [
     'elanmoc',
     'etes603',
     'focaltech_moc',
+    'goodix53x5',
     'nb1010',
     'realtek',
     'synaptics',
@@ -210,6 +212,7 @@ driver_helper_mapping = {
     'aes3500' : [ 'aeslib', 'aes3k' ],
     'aes4000' : [ 'aeslib', 'aes3k' ],
     'uru4000' : [ 'openssl' ],
+    'goodix53x5' : [ 'openssl' ],
     'elanspi' : [ 'udev' ],
     'virtual_image'          : [ 'virtual' ],
     'virtual_device'         : [ 'virtual' ],
diff --git a/meson_options.txt b/meson_options.txt
index 3c4cd26..81238bb 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -2,6 +2,10 @@ option('drivers',
        description: 'Drivers to integrate, "default" selects the default set, "all" selects all drivers',
        type: 'string',
        value: 'default')
+option('goodix550c_volatile_init',
+       description: 'Compile the Goodix 550c volatile USB/MCU initialization path (runtime GOODIX550C_ALLOW_VOLATILE_INIT=1 is also required)',
+       type: 'boolean',
+       value: false)
 option('introspection',
        description: 'Build GObject Introspection repository',
        type: 'boolean',
