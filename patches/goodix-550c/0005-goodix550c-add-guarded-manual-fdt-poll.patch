+        if (goodix_manual_fdt_check_cancelled (ssm, dev))
+          return;
+        if (goodix_manual_fdt_budget_exhausted (ssm, state,
+                                                GOODIX_MANUAL_FDT_MAX_REFERENCE_POLLS,
+                                                phase))
+          return;
+        fpi_ssm_jump_to_state_delayed (ssm,
+                                       GOODIX_REF_CAPTURE_CLEAR_REQUEST,
