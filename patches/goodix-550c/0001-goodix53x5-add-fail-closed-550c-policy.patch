--- /dev/null
+++ b/drivers/goodix53x5/goodix53x5-safety.h
@@ -0,0 +1,47 @@
+/*
+ * Goodix 550c fail-closed command policy.
+ *
+ * Persistent mutations are never permitted.  Normal operation also needs a
+ * bounded set of volatile initialization commands; those require both an
+ * explicit build-time opt-in and GOODIX550C_ALLOW_VOLATILE_INIT=1 at runtime.
+ */
+#pragma once
+
+#include <glib.h>
+
+#ifndef GOODIX550C_ENABLE_VOLATILE_INIT
+#define GOODIX550C_ENABLE_VOLATILE_INIT 0
+#endif
+
+static inline gboolean
+goodix_550c_volatile_init_allowed (void)
+{
+#if GOODIX550C_ENABLE_VOLATILE_INIT
+  return g_strcmp0 (g_getenv ("GOODIX550C_ALLOW_VOLATILE_INIT"), "1") == 0;
+#else
+  return FALSE;
+#endif
+}
+
+static inline gboolean
+goodix_550c_command_is_persistent_mutation (guint8 category,
+                                             guint8 command)
+{
+  return (category == 0xA && command == 0x2) || /* A4: erase app */
+         (category == 0xE && command == 0x0) || /* E0: PSK/container write */
+         (category == 0xE && command == 0x1) || /* E2: production/PSK write */
+         (category == 0xF && command == 0x0) || /* F0: firmware write */
+         (category == 0xF && command == 0x2);   /* F4: firmware check/commit */
+}
+
+static inline gboolean
+goodix_550c_command_needs_volatile_init (guint8 category,
+                                         guint8 command)
+{
+  return (category == 0xA && command == 0x1) || /* A2: sensor/MCU reset */
+         (category == 0x8 && command == 0x0) || /* sensor-register write */
+         (category == 0x9 && command == 0x0) || /* config upload */
+         (category == 0x3 && command >= 0x1 && command <= 0x3) || /* FDT */
+         (category == 0x6 && command == 0x0) || /* sleep */
+         (category == 0xA && command == 0x7);   /* EC power control */
+}
