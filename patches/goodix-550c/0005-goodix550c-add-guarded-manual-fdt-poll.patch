 } GoodixFingerWaitState;
 
@@ -63,6 +90,9 @@
   GOODIX_REF_CAPTURE_GET_IMAGE,
   GOODIX_REF_CAPTURE_DECODE,
   GOODIX_REF_CAPTURE_REG_OFF_DONE,
