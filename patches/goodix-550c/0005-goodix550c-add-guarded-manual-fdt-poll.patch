@@ -93,6 +125,168 @@
 static void goodix_finger_up_ssm_handler (FpiSsm *ssm, FpDevice *dev);
 static void goodix_deactivate_ssm_handler (FpiSsm *ssm, FpDevice *dev);
 
+static gboolean
+goodix_manual_fdt_require_baseline (FpiSsm   *ssm,
+                                    FpDevice *dev)
+{
+  FpiDeviceGoodix53x5 *self = FPI_DEVICE_GOODIX53X5 (dev);
+
+  if (self->fdt_data_tx_on != NULL)
+    return TRUE;
+
+  fpi_ssm_mark_failed (ssm,
+                       fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                                 "Manual-FDT polling has no stable no-finger baseline; reopen with finger removed"));
+  return FALSE;
+}
+
+static gboolean
+goodix_manual_fdt_check_cancelled (FpiSsm   *ssm,
+                                   FpDevice *dev)
+{
+  FpiDeviceGoodix53x5 *self = FPI_DEVICE_GOODIX53X5 (dev);
+
+  if (self->needs_reinit)
+    {
+      fpi_ssm_mark_failed (ssm,
+                           fpi_device_error_new_msg (FP_DEVICE_ERROR_BUSY,
+                                                     "Manual-FDT poll interrupted by system sleep"));
+      return TRUE;
+    }
+
+  if (self->cancel == NULL || !g_cancellable_is_cancelled (self->cancel))
+    return FALSE;
+
+  fpi_ssm_mark_failed (ssm,
+                       g_error_new_literal (G_IO_ERROR,
+                                            G_IO_ERROR_CANCELLED,
+                                            "Manual-FDT polling cancelled"));
+
+  return TRUE;
+}
+
+static void
+goodix_manual_fdt_poll_state_free (GoodixManualFdtPollState *state)
+{
+  if (state == NULL)
+    return;
+
+  /* The SSM frees its data on every exit, including failure and cancellation,
+   * so this is the one place that reliably ends the polling window. */
+  if (state->device != NULL)
+    state->device->manual_fdt_poll_active = FALSE;
+
+  g_clear_pointer (&state->provisional_baseline, g_free);
+  g_free (state);
+}
+
+static GoodixManualFdtPollState *
+goodix_manual_fdt_poll_state_new (FpiSsm              *ssm,
+                                  FpiDeviceGoodix53x5 *self)
+{
+  GoodixManualFdtPollState *state = g_new0 (GoodixManualFdtPollState, 1);
+
+  state->device = self;
+  self->manual_fdt_poll_active = TRUE;
+  fpi_ssm_set_data (ssm, state,
+                    (GDestroyNotify) goodix_manual_fdt_poll_state_free);
+  return state;
+}
+
+/* Fail a settle phase that has spent its poll budget instead of retrying
+ * forever. Returns TRUE when the SSM has been marked failed. */
+static gboolean
+goodix_manual_fdt_budget_exhausted (FpiSsm                   *ssm,
+                                    GoodixManualFdtPollState *state,
+                                    guint                     max_polls,
+                                    const gchar              *phase)
+{
+  if (state->polls < max_polls)
+    return FALSE;
+
+  fpi_ssm_mark_failed (ssm,
+                       fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                                 "Manual-FDT %s did not settle within %u polls; keep the sensor clear",
+                                                 phase, max_polls));
+  return TRUE;
+}
+
+static void
+goodix_manual_fdt_log_poll (GoodixManualFdtPollState *state,
+                            const gchar              *phase,
+                            gboolean                  candidate)
+{
+  gboolean transition = !state->have_last_candidate ||
+                        candidate != state->last_candidate;
+
+  state->polls++;
+  if (candidate)
+    state->consecutive++;
+  else
+    state->consecutive = 0;
+
+  if (transition || candidate ||
+      state->polls % GOODIX_MANUAL_FDT_LOG_RETRY_INTERVAL == 0)
+    fp_dbg ("Manual FDT %s transition: candidate=%u poll=%u consecutive=%u",
+            phase, candidate, state->polls, state->consecutive);
+
+  state->have_last_candidate = TRUE;
+  state->last_candidate = candidate;
+}
+
+static gboolean
+goodix_manual_fdt_measure_reply (FpiSsm        *ssm,
+                                 FpDevice      *dev,
+                                 guint16        threshold,
+                                 const guint8 **out_reading,
+                                 guint         *out_changed_pairs)
+{
+  FpiDeviceGoodix53x5 *self = FPI_DEVICE_GOODIX53X5 (dev);
+  g_autoptr(GError) error = NULL;
+  const guint8 *pl;
+  gsize pl_len;
+  guint16 max_delta;
+
+  if (!goodix_cmd_parse_fdt_manual_reply (dev, &pl, &pl_len, &error))
+    {
+      fpi_ssm_mark_failed (ssm, g_steal_pointer (&error));
+      return FALSE;
+    }
+
+  if (!goodix_device_measure_fdt_delta (self->fdt_data_tx_on, pl + 4,
+                                        GOODIX_FDT_BASE_LEN, threshold,
+                                        &max_delta, out_changed_pairs))
+    {
+      fpi_ssm_mark_failed (ssm,
+                           fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                                     "Malformed manual-FDT baseline comparison"));
+      return FALSE;
+    }
+
+  if (out_reading != NULL)
+    *out_reading = pl + 4;
+  return TRUE;
+}
+
+static void
+goodix_manual_fdt_refresh_baseline (FpiDeviceGoodix53x5 *self,
+                                    const guint8         *reading)
+{
+  guint8 refreshed_base[GOODIX_FDT_BASE_LEN];
+
+  g_free (self->fdt_data_tx_on);
+  self->fdt_data_tx_on = g_memdup2 (reading, GOODIX_FDT_BASE_LEN);
+  goodix_device_generate_fdt_base (self->fdt_data_tx_on,
+                                   GOODIX_FDT_BASE_LEN,
+                                   refreshed_base);
+  memcpy (self->calib.fdt_base_down, refreshed_base,
+          GOODIX_FDT_BASE_LEN);
+  memcpy (self->calib.fdt_base_up, refreshed_base,
+          GOODIX_FDT_BASE_LEN);
+  memcpy (self->calib.fdt_base_manual, refreshed_base,
+          GOODIX_FDT_BASE_LEN);
+}
+
 /* ========================================================================
  * TX-off no-finger reference capture SSM
  * ======================================================================== */
