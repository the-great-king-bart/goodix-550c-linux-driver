From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Fingerprint Lab <noreply@example.invalid>
Date: Fri, 14 Aug 2026 15:20:00 +0200
Subject: [PATCH] goodix550c: refuse a reference frame that carries no signal

A finger enrolled and verified minutes apart in one session scored 0 on all
sixteen of its own samples, with a clean capture and a clean probe. The frame
statistics show why. Through that session the no-finger reference frame
alternated between healthy and empty:

  reference mean=0.0     capture mean=4012.7
  reference mean=0.0     capture mean=1621.4
  reference mean=9.7     capture mean=1684.5
  reference mean=2368.1  capture mean=1641.4

goodix_device_image_to_8bit subtracts that reference from every capture, so an
empty one silently turns the subtraction into a no-op. Stages enrolled while
the reference was empty produced templates from unsubtracted images, and the
later verification, which had a healthy reference, produced a properly
subtracted one. The two share no SIFT features, so the match reports zero
rather than failing anywhere it can be seen.

Refuse such a frame instead of storing it. The condition clears on its own, so
the reference capture retries a bounded number of times before failing the
action; a stored reference is now always one that carried signal.

This also explains the intermittent capture failures chased earlier in this
project: the same empty frame was reaching the coverage gate as a railed
capture and being reported as a placement fault.

---

--- a/drivers/goodix53x5/goodix53x5-private.h
+++ b/drivers/goodix53x5/goodix53x5-private.h
@@ -102,6 +102,15 @@
  * chasing a placement problem they do not have. */
 #define GOODIX_ENROLL_NO_CONTACT_FRACTION 0.90
 
+/* The no-finger reference frame is subtracted from every capture, so one that
+ * carries no signal silently changes the preprocessing rather than failing.
+ * Healthy frames average about 2350 here; frames read while the sensor had
+ * stopped responding average 0 to 10. The condition clears by itself, so a
+ * bounded retry recovers without failing the operator's action. */
+#define GOODIX_REFERENCE_MIN_MEAN 200
+#define GOODIX_REFERENCE_MAX_RETRIES 8
+#define GOODIX_REFERENCE_RETRY_DELAY_MS 120
+
 /* PSK white box for writing all-zero PSK */
 #define GOODIX_PSK_WHITE_BOX_LEN 96
 
@@ -239,6 +248,9 @@
   GPtrArray *enroll_features; /* array of GBytes* serialized SIGFM features */
   gint       enroll_stage;
 
+  /* Consecutive no-signal reference frames in the current capture attempt. */
+  guint      reference_retries;
+
   /* Monotonic time of the previously decoded frame, for the capture-path
    * diagnostic only. Zero until the first frame of a session is decoded. */
   gint64     last_frame_readout_us;
--- a/drivers/goodix53x5/goodix53x5-scan.c
+++ b/drivers/goodix53x5/goodix53x5-scan.c
@@ -134,6 +134,25 @@
 static void goodix_finger_up_ssm_handler (FpiSsm *ssm, FpDevice *dev);
 static void goodix_deactivate_ssm_handler (FpiSsm *ssm, FpDevice *dev);
 
+/**
+ * goodix_reference_frame_has_signal:
+ *
+ * A healthy no-finger reference frame averages around 2350 on this sensor. A
+ * frame the sensor produced while it had stopped responding averages zero, or
+ * single digits. The gate sits far from both, because the point is to reject a
+ * frame that carries nothing at all rather than to judge exposure.
+ */
+static gboolean
+goodix_reference_frame_has_signal (const guint16 *img12)
+{
+  guint64 total = 0;
+
+  for (int i = 0; i < GOODIX_SENSOR_PIXELS; i++)
+    total += img12[i];
+
+  return (total / GOODIX_SENSOR_PIXELS) >= GOODIX_REFERENCE_MIN_MEAN;
+}
+
 /* ========================================================================
  * Capture-path diagnostic
  * ======================================================================== */
@@ -571,6 +590,36 @@
 
         goodix_550c_log_frame_stats (self, img12, "reference", self->calib.dac_l);
 
+        /* A reference frame carrying no signal must never be stored. It is
+         * subtracted from every subsequent capture, so an all-zero one silently
+         * turns the subtraction into a no-op and yields an image preprocessed
+         * differently from every other. Templates enrolled that way share no
+         * SIFT features with captures taken against a healthy reference: a
+         * finger enrolled across a mixture of the two scored 0 on all sixteen
+         * of its own samples, with a clean capture and a clean probe.
+         *
+         * The condition clears by itself, so retry a bounded number of times
+         * before giving up on the action. */
+        if (!goodix_reference_frame_has_signal (img12))
+          {
+            if (self->reference_retries < GOODIX_REFERENCE_MAX_RETRIES)
+              {
+                self->reference_retries++;
+                fp_dbg ("Reference frame carries no signal; retrying (%u/%u)",
+                        self->reference_retries, GOODIX_REFERENCE_MAX_RETRIES);
+                fpi_ssm_jump_to_state_delayed (ssm, GOODIX_REF_CAPTURE_REG_ON,
+                                               GOODIX_REFERENCE_RETRY_DELAY_MS);
+                return;
+              }
+
+            fpi_ssm_mark_failed (ssm,
+                                 fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                                           "Reference frame carried no signal after %u attempts",
+                                                           GOODIX_REFERENCE_MAX_RETRIES));
+            return;
+          }
+        self->reference_retries = 0;
+
         g_clear_pointer (&self->reference_image, g_free);
         self->reference_image = g_steal_pointer (&img12);
 

