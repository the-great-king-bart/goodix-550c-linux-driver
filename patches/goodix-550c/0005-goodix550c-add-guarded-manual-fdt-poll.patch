From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Fingerprint Lab <noreply@example.invalid>
Date: Tue, 11 Aug 2026 16:25:00 +0200
Subject: [PATCH] goodix550c: add guarded manual FDT polling fallback

Experimental firmware-13021 fallback for the observed condition where a
validated raw-24-byte 0x32 ACK does not produce an asynchronous event.
The normal non-TLS and default-off paths remain unchanged. Poll cancellation
is checked only between complete bounded command transactions so no reply is
left queued in the USB endpoint.

Both settle phases carry a poll budget and fail the action when it is spent,
so an unstable pad cannot wedge an enrollment or verification. Only the
finger-down wait polls without a bound, matching the asynchronous path it
replaces. Suspend refuses while a poll owns the device instead of reporting
a clean suspend it cannot honor.

---

--- a/drivers/goodix53x5/goodix53x5-auth.c
+++ b/drivers/goodix53x5/goodix53x5-auth.c
@@ -471,12 +471,10 @@
 
   /* Transport-level failures mean the USB claim/session is likely stale
    * (e.g. system slept while the device was claimed but idle, where the
-   * driver suspend hook never runs). Reinitialize on the next attempt so
-   * one failed auth self-heals instead of failing forever. A clean result
-   * proves the device state is valid. */
-  if (error == NULL)
-    self->needs_reinit = FALSE;
-  else if (goodix_error_indicates_stale_device (error))
+   * driver suspend hook never runs). A successful action does not clear an
+   * already-set reinit requirement: suspend may have raced with a bounded,
+   * non-cancellable command after the manual finger-down phase. */
+  if (error != NULL && goodix_error_indicates_stale_device (error))
     self->needs_reinit = TRUE;
 
   if (action == FPI_DEVICE_ACTION_IDENTIFY)
--- a/drivers/goodix53x5/goodix53x5-calibration.c
+++ b/drivers/goodix53x5/goodix53x5-calibration.c
@@ -339,6 +339,38 @@
   return TRUE;
 }
 
+gboolean
+goodix_device_measure_fdt_delta (const guint8 *baseline,
+                                 const guint8 *reading,
+                                 gsize         len,
+                                 guint16       threshold,
+                                 guint16      *out_max_delta,
+                                 guint        *out_changed_pairs)
+{
+  guint16 max_delta = 0;
+  guint changed_pairs = 0;
+
+  if (baseline == NULL || reading == NULL || len == 0 || (len % 2) != 0 ||
+      out_max_delta == NULL || out_changed_pairs == NULL)
+    return FALSE;
+
+  for (gsize i = 0; i < len; i += 2)
+    {
+      guint16 base = baseline[i] | ((guint16) baseline[i + 1] << 8);
+      guint16 live = reading[i] | ((guint16) reading[i + 1] << 8);
+      guint16 delta = (guint16) abs ((gint) (live >> 1) -
+                                    (gint) (base >> 1));
+
+      max_delta = MAX (max_delta, delta);
+      if (delta > threshold)
+        changed_pairs++;
+    }
+
+  *out_max_delta = max_delta;
+  *out_changed_pairs = changed_pairs;
+  return TRUE;
+}
